---
import type { HTMLAttributes } from "astro/types";

import { cardTitle } from "./variants";

type Props = HTMLAttributes<"div"> & {
  as?: "div" | "h2" | "h3" | "h4";
};

const { as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag {...rest} data-sw-card-title class={cardTitle({ class: className })} data-slot="card-title">
  <slot />
</Tag>
